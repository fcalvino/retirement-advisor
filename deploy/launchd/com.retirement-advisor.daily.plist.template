<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Corrida diaria de retirement-advisor (macOS): scripts/run_daily_alerts.sh → run_scheduler.py --once
  (macro, alertas, scoring del track record y del backtest point-in-time).

  Plantilla: la renderiza scripts/install_launchd.sh (make launchd-install) reemplazando
  __PROJECT_DIR__. No editar la copia de ~/Library/LaunchAgents a mano: se pisa al reinstalar.

  - StartCalendarInterval y no un proceso con sleep: si la Mac dormía a las 07:30, launchd
    corre el disparo perdido al despertar.
  - AI_ENABLED=false / ALERT_AI_EXPLANATIONS=false: nada pago corre desatendido
    (load_dotenv no pisa variables ya seteadas, config.py).
  - Sin --quiet: el log tiene que mostrar "Track record: scored=…" y "synthetic_outcome: …".
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.retirement-advisor.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/run_daily_alerts.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>AI_ENABLED</key>
        <string>false</string>
        <key>ALERT_AI_EXPLANATIONS</key>
        <string>false</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd_daily.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd_daily.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
