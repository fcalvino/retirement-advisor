# `venv` without the slash: in a worktree it is a symlink to the clone's venv
# (`make worktree`), and `venv/` only matches directories.
venv
.venv/
__pycache__/
*.pyc
*.pyo
.DS_Store
data/db/
*.db
.env
*.egg-info/
# Share only the project decision skill and the project subagents; keep other Claude resources local.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/decidir-proyecto/
.claude/skills/decidir-proyecto/*
!.claude/skills/decidir-proyecto/SKILL.md
!.claude/skills/probar-en-vivo/
.claude/skills/probar-en-vivo/*
!.claude/skills/probar-en-vivo/SKILL.md
!.claude/skills/que-sigue/
.claude/skills/que-sigue/*
!.claude/skills/que-sigue/SKILL.md
!.claude/agents/
.claude/agents/*
!.claude/agents/engine-reviewer.md
!.claude/agents/pit-investigator.md
.rtk/
# Skill installers (`npx skills`) write here; this repo's skills live in .claude/skills/.
.agents/
skills-lock.json
.ruff_cache/
.pytest_cache/
logs/

# Scratch space of the decidir-proyecto and probar-en-vivo skills: DB copies,
# measurement and Playwright scripts, screenshots (CONTEXT-DIR-IGNORE).
.context/

# Local / generated QA artifacts (keep scripts + package.json)
qa/node_modules/
qa/shots/
qa/out_*.json

# User-local runtime data (samples live under data/sample_plans/)
# user_preferences.json holds the real personal financial profile (age, capital,
# savings, risk tolerance) — it must never be versioned. The tracked template is
# data/user_preferences.example.json; preferences.py seeds from it on first run.
data/user_preferences.json
data/retirement_plans.json
data/plan_health_history.json
data/personal_book_convictions.json
# Derived cache of the last Screener run (safe to delete; rebuilt on demand).
data/screener_last_run.json
# Local working notes (audit write-ups, scratch plans). Not product docs — they
# must never be committed. See scripts/check_doc_catalog.py for the catalog rule.
plan.md


# playwright-cli scratch (visual review)
.playwright-cli/

# Live eval runs (LLM-4): evidence about a model on a day, not source
data/eval_runs/
